;
; WS2812 / WS2812B, one data pin, sideset 1. 10 cycles per bit.
; At an 8 MHz state-machine clock that is 800 kHz: a 0 is high for
; T1 cycles, a 1 is high for T1+T2, and the line sits low when the
; TX FIFO stalls (the stall is on the side-0 instruction), which is
; the >50 us reset between frames.
;
; Timing matches the pico-sdk ws2812 program (T1=3 T2=3 T3=4).
; JMP targets are assembled for origin 0. pio_res_program adds the
; load offset when it writes them.
;
; Copyright (c) 2020 Raspberry Pi (Trading) Ltd.
; SPDX-License-Identifier: BSD-3-Clause

.program ws2812
.side_set 1

.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
do_one:
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap
