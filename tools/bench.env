# Bench identity for bluetooth_rp2_webapp.
#
# Another, UNRELATED project shares this machine. Its probe serial differs from
# ours only in the middle (E6633861A3-13352C theirs / E6633861A3-40432C ours), so
# nothing here may ever be typed by hand -- source this file instead.
#
#   OFF-LIMITS: E6633861A313352C (probe), DF6544F3CF710D34 (KM003C RP2040),
#               e662608797601f2f + e662608797188929 (LED Matrix), usb0 192.168.7.x

BENCH_PROBE_SERIAL=E6633861A340432C
# Our target: official Raspberry Pi Pico 2 W, RP2350 rev 3, w25q32 4 MB flash.
BENCH_TARGET_ID=F292249E4FCAF6D7

# Our USB-NCM subnet. MUST NOT be 192.168.7.x -- that is the other project's
# live NCM link (usb0 @ 192.168.7.16). Two NCM interfaces on one subnet is a
# routing coin-toss, so ours is a different /24 entirely.
BENCH_NCM_DEVICE_IP=192.168.8.1
BENCH_NCM_HOST_IP=192.168.8.16

# Non-default ports so a second openocd cannot collide with the other project's
# (defaults are 3333/4444/6666).
BENCH_GDB_PORT=3334
BENCH_TELNET_PORT=4445
BENCH_TCL_PORT=6667
BENCH_RTT_PORT=9091

# Raspberry Pi's own openocd, version-matched to SDK 2.3.0. Needs libftdi 1.5.
# The distro build is NOT usable: it ships only rp2040_flash and dies with
# "flash driver 'rp2xxx' not found" on any RP2350 config.
BENCH_OCD_DIR="$HOME/.pico-sdk/openocd/0.12.0+dev"

export PICO_SDK_PATH="$HOME/.pico-sdk/sdk/2.3.0"
export PICO_TOOLCHAIN_PATH="$HOME/.pico-sdk/toolchain/15_2_Rel1"
export PATH="$HOME/.pico-sdk/picotool/2.2.0-a4/picotool:$PATH"
