# Migration image for the Pico 2 W that is on 1.274. Same features as
# pico2w_sd_bnep_defconfig, plus the one-shot layout mover. The image still
# links into the 864 KiB slot and still mounts LittleFS at 2 MiB. It does
# not write the new partition table on its own.
#
# Classic stays for the size check. If the linked image exceeds 884736 bytes
# or the heap gap to 0x20080000 falls under 8192, Classic and NAP come out
# and this file is rebuilt. Wi-Fi and WireGuard stay.
CONFIG_BOARD_PICO2_W=y
CONFIG_NET_WIFI=y
CONFIG_NET_USB_NCM=y
CONFIG_NET_NCM_IP0=192
CONFIG_NET_NCM_IP1=168
CONFIG_NET_NCM_IP2=8
CONFIG_NET_MDNS=y
CONFIG_NET_HOSTNAME="bluetooth-rp2-webapp"
# Same lwIP heap as the product image. The measured peak is 20.6 KB.
CONFIG_LWIP_MEM_SIZE_KB=32
CONFIG_BT_LE=y
CONFIG_BT_CLASSIC=y
CONFIG_BT_CLASSIC_NAP=y
CONFIG_BT_MAX_LINKS=4
CONFIG_LUA_ENABLE=y
CONFIG_LUA_HEAP_KB=116
CONFIG_PEX_POOL_KB=48
# Local builds are unsigned. The product defconfig stays signed-only.
CONFIG_PEX_ALLOW_UNSIGNED=y
# The 864 KiB slot cannot hold Classic (1536-byte ACL, RFCOMM, SDP, BNEP)
# and the HTTPS client together. The web app is plain HTTP. https:// from
# Lua is off in this image, and the 40 KB TLS pool is the RAM that pays
# for the larger ACL buffers.
# CONFIG_NET_HTTP_TLS is not set
CONFIG_LUA_HOOK_BUDGET=20000
CONFIG_IO_PINS=y
CONFIG_IO_GPIO=y
CONFIG_IO_ADC=y
CONFIG_IO_I2C=y
CONFIG_IO_SPI=y
CONFIG_NET_WIREGUARD=y
CONFIG_OTA=y

# pico2w plus the W5500 Ethernet uplink on SPI1:
#   SCK GP14, MOSI GP15, MISO GP8, CS GP13 (plain GPIO), INT GP10, RST GP11.
CONFIG_NET_ETH_W5500=y
CONFIG_ETH_W5500_SPI=1
CONFIG_ETH_W5500_SCK=14
CONFIG_ETH_W5500_MOSI=15
CONFIG_ETH_W5500_MISO=8
CONFIG_ETH_W5500_CS=13
CONFIG_ETH_W5500_INT=10
CONFIG_ETH_W5500_RST=11
CONFIG_ETH_W5500_BAUD=30000000

# pico2w_eth plus an SD card on SDIO (4-bit, PIO): CLK GP2, CMD GP3, D0-D3
# GP4-7, card detect GP9. The same wiring takes the SPI build (pico2w_sdspi).
CONFIG_SD=y
CONFIG_SD_BUS_SDIO=y
CONFIG_SD_SDIO_CLK=2
CONFIG_SD_SDIO_CMD=3
CONFIG_SD_SDIO_D0=4
CONFIG_SD_DETECT=9
# Adafruit's SDIO breakout drives DET high with a card in (measured 2026-10-19).
CONFIG_SD_DETECT_LEVEL=1

CONFIG_FS_LAYOUT=y
