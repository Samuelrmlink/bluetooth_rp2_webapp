CONFIG_BOARD_PICO2_W=y
CONFIG_NET_WIFI=y
CONFIG_NET_USB_NCM=y
CONFIG_NET_NCM_IP0=192
CONFIG_NET_NCM_IP1=168
CONFIG_NET_NCM_IP2=8
CONFIG_NET_MDNS=y
CONFIG_NET_HOSTNAME="bluetooth-rp2-webapp"
CONFIG_LWIP_MEM_SIZE_KB=48
CONFIG_BT_LE=y
CONFIG_BT_MAX_LINKS=4
CONFIG_LUA_ENABLE=y
CONFIG_LUA_HEAP_KB=176
CONFIG_LUA_HOOK_BUDGET=20000
CONFIG_IO_PINS=y
CONFIG_IO_GPIO=y
CONFIG_IO_ADC=y
CONFIG_IO_I2C=y
CONFIG_IO_SPI=y
CONFIG_NET_WIREGUARD=y
CONFIG_OTA=y

# pico2w plus the W5500 Ethernet uplink on SPI1:
#   SCK GP14, MOSI GP15, MISO GP8, CS GP13 (plain GPIO), INT GP10, RST GP11.
CONFIG_NET_ETH_W5500=y
CONFIG_ETH_W5500_SPI=1
CONFIG_ETH_W5500_SCK=14
CONFIG_ETH_W5500_MOSI=15
CONFIG_ETH_W5500_MISO=8
CONFIG_ETH_W5500_CS=13
CONFIG_ETH_W5500_INT=10
CONFIG_ETH_W5500_RST=11
CONFIG_ETH_W5500_BAUD=30000000

# pico2w_eth plus an SD card on SDIO (4-bit, PIO): CLK GP2, CMD GP3, D0-D3
# GP4-7, card detect GP9. The same wiring takes the SPI build (pico2w_sdspi).
CONFIG_SD=y
CONFIG_SD_BUS_SDIO=y
CONFIG_SD_SDIO_CLK=2
CONFIG_SD_SDIO_CMD=3
CONFIG_SD_SDIO_D0=4
CONFIG_SD_DETECT=9
# Adafruit's SDIO breakout drives DET high with a card in (measured 2026-10-19).
CONFIG_SD_DETECT_LEVEL=1
