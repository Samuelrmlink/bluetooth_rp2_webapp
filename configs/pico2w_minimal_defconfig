# Smallest useful image: BLE over USB-NCM only. Exists so the compile gates
# are exercised -- a module that only ever builds alongside its neighbours is
# a module that will not build when you need it off.
CONFIG_BOARD_PICO2_W=y
# CONFIG_NET_WIFI is not set
CONFIG_NET_USB_NCM=y
CONFIG_NET_NCM_IP0=192
CONFIG_NET_NCM_IP1=168
CONFIG_NET_NCM_IP2=8
# CONFIG_NET_MDNS is not set
CONFIG_LWIP_MEM_SIZE_KB=32
CONFIG_BT_LE=y
CONFIG_BT_MAX_LINKS=2

# The Anker codec and its crypto are the whole point of Phase 8, so a build
# WITHOUT them is what proves they are really optional.
# CONFIG_PROTO_ANKER is not set
# The W5500 Ethernet uplink is opt-in: see pico2w_eth_defconfig.
# CONFIG_NET_ETH_W5500 is not set
