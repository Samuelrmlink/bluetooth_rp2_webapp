CONFIG_BOARD_PICO2_W=y
CONFIG_NET_WIFI=y
CONFIG_NET_USB_NCM=y
CONFIG_NET_NCM_IP0=192
CONFIG_NET_NCM_IP1=168
CONFIG_NET_NCM_IP2=8
CONFIG_NET_MDNS=y
CONFIG_NET_HOSTNAME="bluetooth-rp2-webapp"
CONFIG_LWIP_MEM_SIZE_KB=48
CONFIG_BT_LE=y
CONFIG_BT_MAX_LINKS=4
CONFIG_LUA_ENABLE=y
CONFIG_LUA_HEAP_KB=96
CONFIG_LUA_HOOK_BUDGET=20000

# Lua ON but the device codec OFF. This is the combination neither of the
# other two configs reaches, and it is the one that rots: the guard in
# lbind.c that skips lbind_proto_open is only ever compiled out here.
# CONFIG_PROTO_ANKER is not set
CONFIG_IO_PINS=y
CONFIG_IO_GPIO=y
CONFIG_IO_ADC=y
CONFIG_IO_I2C=y
CONFIG_IO_SPI=y
# The W5500 Ethernet uplink is opt-in: see pico2w_eth_defconfig.
# CONFIG_NET_ETH_W5500 is not set
# Forwarding off here: this build embeds the WiFi blob (no OTA partition) and
# sits a few KB under its slot; it also compiles net.* without net.forward.
# CONFIG_NET_FORWARD is not set
# CONFIG_SD is not set
