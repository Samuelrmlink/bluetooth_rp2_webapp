CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new image stays pending until image state-write --confirm. The next
# reboot without that call boots the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# PEX modules are a contiguous RAM copy (medany). The PMP IDRAM split
# marks DRAM non-executable, so a module in the DRAM pool faults on the
# first instruction. Leave the split off on this image.
CONFIG_ESP_SYSTEM_MEMPROT=n
